/* =========================================================
   MFWA — Design tokens
   ========================================================= */
:root{
  --navy:            #0f2e55;
  --navy-ink:        #13315c;   /* titres serif */
  --navy-panel:      #0c2137;   /* panneau actualités */
  --navy-panel-2:    #0a1b2d;
  --blue:            #1b4b8f;   /* chapeau / sous-titre */
  --red:             #e11b22;
  --red-dark:        #c4141b;
  --cream:           #f2f0eb;   /* fond colonne gauche */
  --white:           #ffffff;
  --ink-muted:       #586a7e;   /* 2026-10-21 (a11y) : était #63758a — 4,2:1 seulement sur les fonds pâles, ≥4,7:1 désormais */
  --panel-muted:     #a6b6c6;
  --hairline:        #cfcac1;

  --gutter: clamp(20px, 6.2vw, 90px);
  --header-h: 82px;
  --hero-h: 60vh;
  /* Footer "reveal" effect fallback (see .page-shell / .site-footer below
     and useFooterReveal() in lib/hooks.js): generous enough to fully
     uncover the footer even at its tallest (stacked, mobile) layout, for
     the rare case JS never runs to correct it to the real measured
     height. */
  --footer-h: 620px;

  --font-serif: "Source Serif 4", "Source Serif Pro", Georgia, "Times New Roman", serif;
  --font-sans: "Inter", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;

  --ease: cubic-bezier(.4,0,.2,1);
  --dur-fast: .18s;
  --dur-slow: .5s;
  --radius-sm: 4px;
}
/* La maquette est une identité de marque : elle ne s'inverse pas
   selon le thème du visiteur. On fige les valeurs. */
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ color-scheme: light; }
}
:root[data-theme="dark"]{ color-scheme: light; }

/* =========================================================
   Base
   ========================================================= */
*,*::before,*::after{ box-sizing:border-box; }
html{ -webkit-text-size-adjust:100%; }
body{
  margin:0;
  background:var(--white);
  color:var(--navy);
  font-family:var(--font-sans);
  font-size:16px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
img{ max-width:100%; display:block; }
figure{ margin:0; }
a{ color:inherit; text-decoration:none; }
button{ font:inherit; color:inherit; background:none; border:0; cursor:pointer; }
:focus-visible{ outline:2px solid var(--red); outline-offset:3px; }
@media (prefers-reduced-motion: reduce){
  *{ transition-duration:.01ms !important; animation-duration:.01ms !important; }
}

/* -- Lien d'évitement -------------------------------------- */
.skip-link{
  position:absolute;
  top:-48px; left:16px;
  z-index:100;
  padding:12px 20px;
  background:var(--navy);
  color:var(--white);
  font-size:14px;
  font-weight:600;
  border-radius:0 0 var(--radius-sm) var(--radius-sm);
  transition:top var(--dur-fast) var(--ease);
}
.skip-link:focus{ top:0; }

/* -- Chargement progressif des images ------------------------ */
img.is-loading{ opacity:0; }
img{ transition:opacity var(--dur-slow) var(--ease); }

/* -- Révélation au défilement -------------------------------- */
[data-reveal]{
  opacity:0;
  transform:translateY(24px);
  transition:opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
}
[data-reveal].is-visible{ opacity:1; transform:none; }
[data-reveal="stagger"] > *{
  opacity:0;
  transform:translateY(24px);
  transition:opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
}
[data-reveal="stagger"].is-visible > *{ opacity:1; transform:none; }

/* =========================================================
   Barre utilitaire (label partenaire + langues)
   ========================================================= */
.utility-bar{
  background:var(--cream);
  border-bottom:1px solid var(--hairline);
}
.utility-bar__inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:9px var(--gutter);
}

.utility-bar__badge{
  display:flex;
  align-items:baseline;
  gap:10px;
  min-width:0;
}
.utility-bar__badge-mark{
  flex:none;
  font-family:var(--font-sans);
  font-weight:700;
  font-size:13px;
  letter-spacing:-.01em;
  color:var(--blue);
}
.utility-bar__badge-mark em{ font-style:italic; font-weight:600; }
.utility-bar__badge-text{
  font-size:11px;
  color:var(--ink-muted);
  letter-spacing:.01em;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.lang-switch{
  flex:none;
  display:flex;
  align-items:center;
  gap:8px;
  font-size:11px;
  font-weight:700;
  letter-spacing:.04em;
}
.lang-switch__link{
  color:var(--ink-muted);
  transition:color var(--dur-fast) var(--ease);
}
.lang-switch__link:hover,
.lang-switch__link.is-active{ color:var(--navy); }
.lang-switch__sep{ color:var(--hairline); }

@media (max-width:760px){
  .utility-bar__badge-text{ display:none; }
}
@media (max-width:420px){
  .utility-bar__badge{ display:none; }
  .utility-bar__inner{ justify-content:flex-end; }
}

/* =========================================================
   En-tête
   ========================================================= */
.header{
  position:relative;
  z-index:10;
  height:var(--header-h);
  background:var(--white);
  display:flex;
  align-items:center;
  padding:0 var(--gutter);
}
.header__inner{
  width:100%;
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:24px;
}
/* Per-programme accent (2026-09-30, at Yv's call): the 5 programme
   detail pages pass a "tone" prop through to Header so the site-wide
   nav picks up that page's pastel colour (same 5 hex values as
   .ab-focus-panel--<tone> below, reused on purpose for consistency).
   Every other page renders <Header> with no tone, so .header keeps its
   plain white background everywhere else. Revert: drop the "tone" prop
   passed to <Header> in the 5 app/programmes/<slug>/page.js files (and
   the tone={...} param on Header.js itself) — these rules stop matching. */
.header--red{ background:#fce8e6; }
.header--navy{ background:#e4eefa; }
.header--lavender{ background:#ece7fb; }
.header--green{ background:#e3f3ea; }
.header--amber{ background:#fdf3dd; }

/* -- Logo ------------------------------------------------ */
.brand{ display:flex; align-items:center; gap:16px; }
.logo{
  max-width: 120px;
}
.brand__mark{
  position:relative;
  display:flex;
  align-items:baseline;
  font-weight:800;
  font-size:34px;
  line-height:1;
  letter-spacing:-.035em;
  color:var(--navy);
}
.brand__mark i{ font-style:normal; }
.brand__mark .is-red{ color:var(--red); }
.brand__swoosh{
  position:absolute;
  top:-7px;
  left:29px;
  width:30px;
  height:20px;
  overflow:visible;
}
.brand__name{
  font-size:12px;
  line-height:1.35;
  font-weight:500;
  color:var(--ink-muted);
  letter-spacing:.005em;
  max-width:120px;
}

/* -- Navigation ------------------------------------------ */
.nav{ display:flex; align-items:center; gap:36px; }
.nav__link{
  font-size:14px;
  font-weight:500;
  color:var(--navy);
  padding:6px 0;
  position:relative;
}
.nav__link::after{
  content:"";
  position:absolute;
  left:0; right:0; bottom:0;
  height:2px;
  background:var(--red);
  transform:scaleX(0);
  transform-origin:left;
  transition:transform var(--dur-fast) var(--ease);
}
.nav__link:hover::after,
.nav__link[aria-current="page"]::after{ transform:scaleX(1); }

/* -- Actions --------------------------------------------- */
.header__actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:26px;
}

/* EN/FR: this app has no French content of its own yet, so FR is a real
   link out to the equivalent page on the live mfwa.org site (see
   LanguageSwitcher.js) — EN is the current, non-interactive state.
   Underline-on-hover echoes .nav__link for a consistent, understated feel. */
.lang-switch{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:12px;
  font-weight:600;
  letter-spacing:.05em;
  color:var(--ink-muted);
}
.lang-switch__lang{
  position:relative;
  color:inherit;
  padding:4px 0;
}
.lang-switch__lang.is-current{
  color:var(--navy);
  cursor:default;
}
.lang-switch a.lang-switch__lang::after{
  content:"";
  position:absolute;
  left:0; right:0; bottom:0;
  height:1.5px;
  background:var(--red);
  transform:scaleX(0);
  transform-origin:left;
  transition:transform var(--dur-fast) var(--ease);
}
.lang-switch a.lang-switch__lang:hover::after{ transform:scaleX(1); }
.lang-switch__divider{ color:var(--hairline); }
.icon-btn{
  width:34px; height:34px;
  display:grid; place-items:center;
  border-radius:50%;
  color:var(--navy);
  transition:background-color var(--dur-fast) var(--ease);
}
.icon-btn:hover{ background:#f1f1ee; }

.btn{
  display:inline-flex;
  align-items:center;
  gap:12px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  background:var(--red);
  color:var(--white);
  transition:background-color var(--dur-fast) var(--ease);
}
.btn:hover{ background:var(--red-dark); }
.btn--donate{ height:44px; padding:0 22px; border-radius:var(--radius-sm); }
.btn--hero{ height:clamp(44px, 5.4vh, 52px); padding:0 clamp(22px, 2vw, 30px); border-radius:var(--radius-sm); }
.btn svg{ flex:none; }

/* =========================================================
   Hero
   ========================================================= */
.hero{
  display:grid;
  grid-template-columns:2fr 3fr;
  /* `min-height`, not `height`+`max-height`+`overflow:hidden`: 60vh is a
     target, not a hard cap. The old hard cap clipped/crushed the intro
     column's text and buttons the moment the viewport got short-but-wide
     (e.g. devtools docked at the bottom) — every other section on this
     site sizes itself from its content (padding + clamp()), never from a
     hard vh ceiling, which is why only the hero showed this. `min-height`
     keeps the 60vh look on a normal viewport but lets the row grow past
     it rather than squeeze content into too little space. The <900px
     media query below already resets this to `min-height:0` + `height:
     auto` for mobile, so it continues to work unchanged. */
  min-height:var(--hero-h);
}

/* -- Bloc fusionné : photo + actualité -------------------- */
.hero__feature{
  display:grid;
  grid-template-columns:35fr 24fr;
  min-height:0;
  overflow:hidden;
}

/* -- Colonne 1 : accroche -------------------------------- */
.hero__intro{
  background:var(--cream);
  padding:clamp(28px, 5.5vh, 88px) var(--gutter) clamp(24px, 4.5vh, 70px);
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  min-height:0;
  overflow:hidden;
}

/* -- Carrousel : les 4 slides occupent la même cellule --- */
.hero__slides{
  display:grid;
  flex:1 1 auto;
  min-height:0;
}
.hero-slide{
  grid-area:1 / 1;
  align-self:start;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  opacity:0;
  visibility:hidden;
  transform:translateY(10px);
  transition:opacity .55s ease, transform .55s ease, visibility .55s;
}
.hero-slide.is-active{
  opacity:1;
  visibility:visible;
  transform:none;
}

.eyebrow{
  display:flex;
  align-items:center;
  gap:16px;
  font-size:11px;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--navy);
}
.eyebrow::before{
  content:"";
  width:26px; height:3px;
  background:var(--red);
  flex:none;
}
.hero__title{
  margin:clamp(12px, 2.2vh, 30px) 0 0;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(28px, 3vw, 40px);
  line-height:1.1;
  letter-spacing:-.015em;
  color:var(--navy-ink);
}
.hero__lede{
  margin:clamp(10px, 2vh, 28px) 0 0;
  max-width:33ch;
  font-size:clamp(16px, .4vw + 13px, 18px);
  line-height:1.55;
  font-weight:600;
  color:var(--blue);
}
.hero__cta{ margin-top:clamp(14px, 2.6vh, 34px); align-self:flex-start; }

/* -- Pagination du carrousel ----------------------------- */
.slider{
  display:flex;
  align-items:center;
  gap:clamp(24px, 3vw, 42px);
  margin-top:clamp(16px, 3vh, 56px);
}
.slider__count{
  font-size:15px;
  font-weight:500;
  color:var(--ink-muted);
  letter-spacing:.02em;
}
.slider__count b{
  font-size:21px;
  font-weight:700;
  color:var(--navy-ink);
  margin-right:2px;
}
.slider__nav{ display:flex; gap:14px; }
.slider__btn{
  width:clamp(38px, 4.6vh, 44px); height:clamp(38px, 4.6vh, 44px);
  border:1px solid var(--hairline);
  border-radius:50%;
  display:grid; place-items:center;
  color:var(--navy-ink);
  transition:border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
}
.slider__btn:hover{ border-color:var(--navy-ink); background:rgba(15,46,85,.05); }

/* -- Colonne 2 : photo ----------------------------------- */
.hero__media{
  position:relative;
  display:grid;
  overflow:hidden;
  background:
    radial-gradient(120% 90% at 30% 22%, #6f7a6a 0%, #3d4a45 45%, #23302f 100%);
}
.hero__shot{
  grid-area:1 / 1;
  position:relative;
  opacity:0;
  visibility:hidden;
  transition:opacity .7s ease, visibility .7s;
}
.hero__shot.is-active{ opacity:1; visibility:visible; }
.hero__shot img{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
}
.hero__shot::after{
  content:"";
  position:absolute; left:0; right:0; bottom:0;
  height:45%;
  background:linear-gradient(to top, rgba(8,18,28,.72), rgba(8,18,28,0));
}
.hero__caption{
  position:absolute;
  left:clamp(20px, 2.6vw, 40px); bottom:clamp(20px, 3.4vh, 34px);
  z-index:2;
  display:flex;
  align-items:center;
  gap:12px;
  font-size:12px;
  font-weight:600;
  letter-spacing:.17em;
  text-transform:uppercase;
  color:var(--white);
}
.hero__caption span{
  width:4px; height:4px;
  border-radius:50%;
  background:rgba(255,255,255,.75);
}

/* -- Colonne 3 : actualité ------------------------------- */
.hero__news{
  background:var(--navy-panel);
  color:var(--white);
  padding:clamp(24px, 4vh, 44px) clamp(22px, 2.5vw, 36px) clamp(26px, 4.5vh, 48px);
  display:flex;
  flex-direction:column;
  min-height:0;
  overflow:hidden;
}
.hero__news .eyebrow{ color:var(--white); }
.news__title{
  margin:clamp(12px, 2.2vh, 22px) 0 0;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(20px, 1.1vw + 10px, 27px);
  line-height:1.24;
  letter-spacing:-.005em;
  color:var(--white);
}
.news__text{
  margin:clamp(10px, 1.8vh, 20px) 0 0;
  font-size:14px;
  line-height:1.6;
  color:var(--panel-muted);
  max-width:34ch;
}
.news__link{
  display:inline-flex;
  align-items:center;
  gap:11px;
  margin-top:clamp(14px, 2.4vh, 26px);
  font-size:12px;
  font-weight:600;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--white);
  align-self:flex-start;
}
.news__link svg{ transition:transform var(--dur-fast) var(--ease); }
.news__link:hover svg{ transform:translateX(4px); }
.news__thumb{
  position:relative;
  display:grid;
  margin-top:clamp(14px, 2.6vh, 28px);
  flex:1 1 auto;
  min-height:0;
  overflow:hidden;
  border-radius:2px;
  background:
    radial-gradient(110% 120% at 25% 30%, #4a5c6b 0%, #2b3a48 55%, #16222e 100%);
}
.news__thumb-slide{
  grid-area:1 / 1;
  position:relative;
  opacity:0;
  visibility:hidden;
  transition:opacity .8s ease, visibility .8s;
}
.news__thumb-slide.is-active{ opacity:1; visibility:visible; }
.news__thumb-slide img{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
}

/* =========================================================
   Responsive
   ========================================================= */
/* Écrans peu hauts : la vignette n'aurait plus qu'un filet de hauteur,
   mieux vaut la retirer que d'afficher une bande de quelques pixels. */
@media (min-width:901px) and (max-height:780px){
  .news__thumb{ display:none; }
}

@media (max-width:1180px){
  .hero__feature{ grid-template-columns:57fr 43fr; }
  .hero__title{ font-size:clamp(28px, 3.2vw, 38px); max-width:none; }
  .hero__intro > .eyebrow{ font-size:10px; letter-spacing:.1em; gap:12px; }
  .hero__lede{ font-size:16px; max-width:38ch; }
  .news__title{ font-size:23px; }
  .nav{ gap:26px; }
}

@media (max-width:900px){
  :root{ --header-h:70px; }
  .header__inner{ grid-template-columns:auto 1fr; }
  .nav{ display:none; }
  .hero{
    grid-template-columns:1fr;
    height:auto;
    min-height:0;
    max-height:none;
    overflow:visible;
  }
  .hero__feature{ grid-template-columns:1fr; }
  .hero__intro{ padding:56px var(--gutter) 44px; }
  .hero__title{ max-width:12ch; }
  .hero__lede{ max-width:46ch; }
  .hero__media{ aspect-ratio:16/10; }
  .hero__news{ padding:40px var(--gutter) 48px; }
  .news__title{ font-size:26px; max-width:18ch; }
  .news__text{ max-width:52ch; }
  .news__thumb{ max-width:420px; flex:0 0 auto; aspect-ratio:287/135; }
}

@media (max-width:560px){
  .brand__name{ display:none; }
  .btn--donate{ padding:0 16px; }
  .header__actions{ gap:12px; }
  .slider{ gap:26px; margin-top:44px; }
  .hero__caption{ left:var(--gutter); bottom:24px; }
}

/* =========================================================
   Bandeau de filtres (au-dessus des actualités)
   ========================================================= */
.topics{
  display:flex;
  align-items:center;
  gap:34px;
  padding:17px 30px;
  border-radius:999px;
  background:#f5faff;
  overflow-x:auto;
  scrollbar-width:none;
  -webkit-overflow-scrolling:touch;
}
.topics::-webkit-scrollbar{ display:none; }

.topics__item{
  flex:none;
  display:flex;
  align-items:center;
  gap:9px;
  font-size:11.5px;
  font-weight:700;
  letter-spacing:.09em;
  text-transform:uppercase;
  color:var(--navy);
  white-space:nowrap;
  padding:2px 0;
  position:relative;
}
/*.topics__item::after{
  content:"";
  position:absolute;
  left:0; right:0; bottom:-3px;
  height:2px;
  background:var(--red);
  transform:scaleX(0);
  transform-origin:left;
  transition:transform var(--dur-fast) var(--ease);
}*/
.topics__item:hover{ color:var(--red-dark); }
.topics__item:hover::after,
.topics__item.is-active::after{ transform:scaleX(1); }

.topics__dot{
  width:7px; height:7px;
  border-radius:50%;
  background:var(--red);
  flex:none;
}

.topics__sep{
  flex:none;
  color:var(--hairline);
  font-weight:400;
}

@media (max-width:560px){
  .topics{ gap:22px; padding:14px 22px; }
}

/* =========================================================
   Actualités — « The latest from MFWA »
   ========================================================= */
.latest{
  padding:30px var(--gutter) 30px;
}
.latest > .topics{
  margin-bottom:clamp(30px, 4vw, 30px);
}

.latest__head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}
.latest__all{
  display:inline-flex;
  align-items:center;
  gap:10px;
  flex:none;
  font-size:13px;
  font-weight:600;
  color:var(--navy);
}
.latest__all svg{ flex:none; transition:transform var(--dur-fast) var(--ease); }
.latest__all:hover svg{ transform:translateX(4px); }

.latest__title{
  margin: 0;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(28px, 3vw, 38px);
  line-height:1.16;
  letter-spacing:-.015em;
  color:var(--navy-ink);
}

.latest__grid{
  padding-top:40px;
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:clamp(20px, 2.2vw, 32px);
}

/* -- Éléments communs aux articles ------------------------ */
.story__link{
  display:block;
  color:inherit;
}
.story__media{
  position:relative;
  overflow:hidden;
  border-radius:2px;
  background:
    radial-gradient(120% 90% at 30% 22%, #6f7a6a 0%, #3d4a45 45%, #23302f 100%);
}
.story__media img{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
  transition:transform var(--dur-slow) var(--ease), opacity var(--dur-slow) var(--ease);
}
.story__link:hover .story__media img{ transform:scale(1.045); }

.story__media--fallback{
  background:var(--cream);
}
.story__media--fallback img{
  object-fit:contain;
  padding:18%;
  opacity:.85;
}
.story__link:hover .story__media--fallback img{ transform:none; }

.story__tag{
  display:flex;
  align-items:center;
  gap:7px;
  font-size:11px;
  font-weight:600;
  letter-spacing:.11em;
  text-transform:uppercase;
  color:var(--blue);
}
