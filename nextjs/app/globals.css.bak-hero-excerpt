/* =========================================================
   Effet "reveal" du footer
   ========================================================= */
/* .page-shell wraps every page's skip-link + header + main (everything
   except <Footer>, which each page still renders as its own sibling
   right after it — see app/page.js, app/category/[slug]/page.js,
   app/articles/[slug]/page.js). Giving it an opaque background and a
   higher z-index than the footer means the footer stays hidden behind it
   for the whole normal scroll, and only shows through once .page-shell's
   own bottom edge has scrolled past the viewport's bottom — the classic
   "fixed, revealed on scroll" footer parallax. margin-bottom (from
   --footer-h, kept in sync with the footer's real height by
   useFooterReveal()) is what gives scrolling enough extra room to fully
   uncover it.
   Skipped under prefers-reduced-motion: the footer just sits in normal
   flow instead, since the reveal is itself a scroll-linked motion
   effect some people will want off. */
.page-shell{
  position:relative;
  z-index:1;
  background:var(--white);
  min-height:100vh;
}
@media (prefers-reduced-motion: no-preference){
  /* -1px : la page recouvre d'un pixel le haut du pied de page, pour qu'aucun
     arrondi sous-pixel ne laisse apparaître un fin filet blanc entre les deux (2026-10-18) */
  .page-shell{ margin-bottom:calc(var(--footer-h) - 1px); }
  .site-footer{
    position:fixed;
    left:0; right:0; bottom:0;
    z-index:0;
  }
}

