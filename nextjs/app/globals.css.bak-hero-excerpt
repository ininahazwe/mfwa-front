   Motifs (flat SVG, CSS-animated)
   ========================================================= */
.motif{ display:block; overflow:visible; }
.motif *{ transform-box:fill-box; transform-origin:center; }
.m-fill-a{ fill:var(--m-a); }
.m-fill-b{ fill:var(--m-b); }
.m-fill-c{ fill:var(--m-c); }
.m-fill-bg{ fill:var(--m-bg); }
.m-stroke-a{ fill:none; stroke:var(--m-a); stroke-width:1.5; stroke-linecap:round; }
.m-stroke-b{ fill:none; stroke:var(--m-b); stroke-width:1.5; stroke-linecap:round; }

.motif__ping{ animation:motifPing 3s cubic-bezier(.2,.6,.3,1) infinite; }
@keyframes motifPing{
  0%{ transform:scale(.25); opacity:1; }
  100%{ transform:scale(1.5); opacity:0; }
}
.motif__bar{ transform-origin:50% 100%; animation:motifBar 1.3s ease-in-out infinite alternate; }
@keyframes motifBar{
  from{ transform:scaleY(.22); }
  to{ transform:scaleY(1); }
}
.motif__spin{ transform-box:view-box; transform-origin:50px 50px; animation:motifSpin 7s linear infinite; }
@keyframes motifSpin{ to{ transform:rotate(360deg); } }
.motif__breathe{ animation:motifBreathe 4s ease-in-out infinite alternate; }
@keyframes motifBreathe{
  from{ transform:scale(.82); }
  to{ transform:scale(1.12); }
}
.motif__blink{ animation:motifBlink 2.2s ease-in-out infinite alternate; }
@keyframes motifBlink{
  from{ opacity:.15; }
  to{ opacity:1; }
}
.motif__flip{ transform-box:view-box; transform-origin:50px 50px; animation:motifFlip 6s cubic-bezier(.65,0,.35,1) infinite; }
@keyframes motifFlip{
  0%, 30%{ transform:rotate(0deg); }
  50%, 80%{ transform:rotate(180deg); }
  100%{ transform:rotate(360deg); }
}
.motif__bob{ animation:motifBob 2.6s ease-in-out infinite alternate; }
@keyframes motifBob{
  from{ transform:translateY(4px); }
  to{ transform:translateY(-4px); }
}
.m-lens{ fill:var(--m-bg); stroke:var(--m-a); }
.motif text{ font-family:var(--font-sans); }
.motif__label{ font-size:11px; font-weight:800; letter-spacing:.14em; }
.motif__label--sm{ font-size:7px; letter-spacing:.08em; }
.motif__faint{ opacity:.28; }

/* mic — sound arcs pulse outwards */
.motif__arc{ animation:motifArc 1.8s ease-in-out infinite; }
.motif__arc--late{ animation-delay:.3s; }
@keyframes motifArc{
  0%, 100%{ opacity:.15; }
  40%{ opacity:1; }
}
/* camera — lens iris + flash burst */
.motif__iris{ animation:motifIris 3.2s ease-in-out infinite; }
@keyframes motifIris{
  0%, 100%{ transform:scale(1); }
  50%{ transform:scale(.55); }
}
.motif__flash{ animation:motifFlash 3.2s ease-out infinite; }
@keyframes motifFlash{
  0%, 44%, 64%, 100%{ opacity:0; }
  48%{ opacity:1; }
}
/* newspaper — lines "typeset" one after another */
.motif__type{ transform-origin:0 50%; animation:motifType 3.6s ease-in-out infinite; }
@keyframes motifType{
  0%{ transform:scaleX(0); }
  25%, 80%{ transform:scaleX(1); }
  100%{ transform:scaleX(0); opacity:0; }
}
/* pen — nib writes a line */
.motif__draw{ stroke-dasharray:100; animation:motifDraw 3.6s ease-in-out infinite; }
@keyframes motifDraw{
  0%{ stroke-dashoffset:100; }
  55%, 80%{ stroke-dashoffset:0; }
  100%{ stroke-dashoffset:-100; }
}
.motif__scribble{ transform-box:view-box; animation:motifScribble 1.8s ease-in-out infinite alternate; }
@keyframes motifScribble{
  from{ transform:translate(-26px, 16px); }
  to{ transform:translate(14px, 14px); }
}
/* press card — sways on its lanyard */
.motif__sway{ transform-box:view-box; transform-origin:50px 28px; animation:motifSway 2.8s ease-in-out infinite alternate; }
@keyframes motifSway{
  from{ transform:rotate(-7deg); }
  to{ transform:rotate(7deg); }
}
/* megaphone — kicks and shouts */
.motif__shake{ transform-box:view-box; transform-origin:40px 50px; animation:motifShake 1.2s ease-in-out infinite alternate; }
@keyframes motifShake{
  from{ transform:rotate(-4deg); }
  to{ transform:rotate(3deg); }
}
.motif__shout{ animation:motifShout 1.2s ease-out infinite; }
@keyframes motifShout{
  0%{ opacity:0; transform:translateX(-6px); }
  40%{ opacity:1; }
  100%{ opacity:0; transform:translateX(6px); }
}
/* magnifier — scans the page */
.motif__scan{ transform-box:view-box; animation:motifScan 4s ease-in-out infinite alternate; }
@keyframes motifScan{
  0%{ transform:translate(-8px, -10px); }
  50%{ transform:translate(20px, 4px); }
  100%{ transform:translate(0, 18px); }
}
/* video — playhead progress */
.motif__progress{ transform-origin:0 50%; animation:motifProgress 5s linear infinite; }
@keyframes motifProgress{
  from{ transform:scaleX(0); }
  to{ transform:scaleX(1); }
}
@media (prefers-reduced-motion: reduce){
  .motif, .motif *{ animation:none !important; }
  .motif__draw{ stroke-dasharray:none; }
  .ab-stagger[data-reveal="stagger"] > *{ transition-delay:0ms !important; }
}

/* =========================================================
   1. Hero
   ========================================================= */
/* overflow:hidden (2026-09-30): clips the decorative blob below
   (.ab-hero__blob*) to this section's own box instead of the page —
   shared with AboutHero.js's ".ab-hero" too, but nothing there bleeds
   past its box today, so this has no visible effect there. */
.ab-hero{ overflow:hidden; }
.ab-hero__grid{
  display:grid;
  grid-template-columns:repeat(12, minmax(0, 1fr));
  column-gap:var(--ab-col-gap);
  align-items:center;
  padding-top:clamp(48px, 8vh, 96px);
  padding-bottom:clamp(56px, 8vh, 96px);
}
.ab-hero__copy{ grid-column:1 / span 6; grid-row:1; }
.ab-hero__title{
  margin:clamp(14px, 2.2vh, 26px) 0 0;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(40px, 4.6vw, 68px);
  line-height:1.06;
  letter-spacing:-.02em;
  color:var(--navy-ink);
}
.ab-hero__line{ display:block; }
.ab-hero__foot{ margin-top:clamp(20px, 3vh, 32px); max-width:46ch; }
.ab-hero__lede{
  margin:0;
  font-size:clamp(16px, .4vw + 13px, 18px);
  line-height:1.55;
  font-weight:600;
  color:var(--blue);
}
.ab-hero__actions{
  margin-top:clamp(22px, 3.4vh, 36px);
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:28px;
}

.ab-tiles{
  grid-column:8 / -1;
  grid-row:1;
  justify-self:end;
  width:100%;
  max-width:560px;
  display:grid;
  grid-template-columns:repeat(3, 1fr);
}
.ab-tile{
  aspect-ratio:1;
  display:grid;
  place-items:center;
  background:var(--m-bg);
  transition:background-color var(--dur-slow) var(--ease);
}
.ab-tile .motif{ width:66%; height:66%; transition:transform var(--dur-slow) var(--ease); }
.ab-tile:hover .motif{ transform:scale(1.08); }
.ab-tile--white{ --m-bg:var(--white); }
.ab-tile--pale{ --m-bg:#f5faff; }
.ab-tile--dark{ --m-bg:var(--navy-panel); --m-a:var(--white); --m-c:#5b86c7; }
.ab-tile--red{ --m-bg:var(--red); --m-a:var(--white); --m-b:var(--navy-ink); }

/* Tiles slot + colour blob (2026-09-30, at Yv's call): wraps the tile <ul>
   (components/InvolvedHero.js) only when it's rendered with a "tone" —
   i.e. only on the 5 programme detail pages, never the /programmes hub
   (all 5 programmes at once, no single blob colour) nor Where We
   Work/Intern/Volunteer (no tone passed there either). Duplicates the
   grid-column/row/justify-self already on .ab-tiles rather than moving
   them, since .ab-tiles itself is still needed unchanged for its OTHER
   role — the 3-col grid that actually lays out the tiles — and is also
   reused as-is by AboutHero.js/BoardHero.js, which never get this
   wrapper. */
.ab-hero__tiles-slot{
  grid-column:8 / -1;
  grid-row:1;
  justify-self:end;
  position:relative;
  /* Explicit width/max-width (matching .ab-tiles' own, rather than
     relying on justify-self's shrink-to-fit sizing): without this, the
     wrapper's box resolves far wider than the tile grid it wraps (the ul
     inside has width:100%, so shrink-to-fit sizing anchors to the whole
     grid track, not to 560px) and the 170%-sized blob balloons to cover
     the entire hero instead of just bleeding past the tiles. */
  width:100%;
  max-width:560px;
}
.ab-hero__tiles-slot .ab-tiles{ position:relative; z-index:1; }
.ab-hero__blob{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%, -50%); /* no-JS / reduced-motion fallback; useParallax() overrides this inline once mounted */
  width:170%;
  height:170%;
  border-radius:50%;
  z-index:0;
  pointer-events:none;
  filter:blur(70px);
  will-change:transform;
}
/* Each tone blends 3 shades of the same hue (a light highlight, the core
   tone, a deeper shadow) — the blur above is what fuses them into one
   soft, painterly blob rather than three visible rings. */
.ab-hero__blob--red{
  background:
    radial-gradient(circle at 34% 30%, #ff9466 15%, transparent 1%),
    radial-gradient(circle at 66% 72%, var(--red-dark) 10%, transparent 1%),
    radial-gradient(circle at 50% 50%, var(--red) 5%, #fce8e6 55%, transparent 90%);
  opacity: 0.5;
}
.ab-hero__blob--navy{
  background:
    radial-gradient(circle at 34% 30%, #7fb2e5 15%, transparent 34.8%),
    radial-gradient(circle at 66% 72%, var(--navy-ink) 10%, transparent 37.9%),
    radial-gradient(circle at 50% 50%, var(--blue) 5%, #e4eefa 55%, transparent 47.4%);
  opacity: 0.5;
}
.ab-hero__blob--lavender{
  background:
    radial-gradient(circle at 34% 30%, #b9a9f2 15%, transparent 34.8%),
    radial-gradient(circle at 66% 72%, #5b4bb0 10%, transparent 37.9%),
    radial-gradient(circle at 50% 50%, #7c6fd1 5%, #ece7fb 55%, transparent 47.4%);
  opacity: 0.5;
}
.ab-hero__blob--green{
  background:
    radial-gradient(circle at 34% 30%, #8fd6b4 15%, transparent 34.8%),
    radial-gradient(circle at 66% 72%, #2a7d5c 10%, transparent 37.9%),
    radial-gradient(circle at 50% 50%, #3fa579 5%, #e3f3ea 55%, transparent 47.4%);
  opacity: 0.5;
}
.ab-hero__blob--amber{
  background:
    radial-gradient(circle at 34% 30%, #f4cf7a 15%, transparent 34.8%),
    radial-gradient(circle at 66% 72%, #b9811a 10%, transparent 37.9%),
    radial-gradient(circle at 50% 50%, #e0a52e 5%, #fdf3dd 55%, transparent 47.4%);
  opacity: 0.5;
}
@media (prefers-reduced-motion: reduce){
  .ab-hero__blob{ transform:translate(-50%, -50%) !important; }
}
/* Hub-only tile tones (2026-09-30, at Yv's call): the /programmes hero's
   5 cross-nav tiles get their own programme's colour instead of the
   generic dark/pale/white rotation — same pastel values as
   .ab-focus-panel--<tone>/.header--<tone>/.ab-hero--<tone> elsewhere.
   Named "prog-*" (not "red"/"navy"/...) to avoid colliding with
   .ab-tile--red above, a bold accent already used by AboutHero.js's
   decorative tile grid — these are pale backgrounds, unrelated to that
   one. Revert: see the comment on PROGRAMME_TILES in lib/content.js. */
.ab-tile--prog-red{ --m-bg:#fce8e6; }
.ab-tile--prog-navy{ --m-bg:#e4eefa; }
.ab-tile--prog-lavender{ --m-bg:#ece7fb; }
.ab-tile--prog-green{ --m-bg:#e3f3ea; }
.ab-tile--prog-amber{ --m-bg:#fdf3dd; }

/* =========================================================
   2. At a glance
   ========================================================= */
.ab-glance{ padding-bottom:clamp(56px, 8vh, 96px); }
.ab-glance__panel{
  display:grid;
  grid-template-columns:repeat(12, minmax(0, 1fr));
  column-gap:var(--ab-col-gap);
  padding:clamp(28px, 3.6vw, 48px);
  background: #eef4f9;
  border-radius:var(--radius-sm);
}
.ab-glance__intro{
  grid-column:1 / span 4;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  gap:28px;
}
.ab-glance__motif{ width:88px; height:88px; }
.ab-glance__note{ margin:0; font-size:12px; color:var(--ink-muted); }
.ab-glance__stats{
  grid-column:6 / -1;
  margin:0;
  padding:0;
  list-style:none;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:36px var(--ab-col-gap);
}
.ab-glance__stat{ padding-top:18px; }
.ab-glance__num{
  display:block;
  font-family:var(--font-sans);
  font-weight:800;
  font-size:clamp(40px, 4.4vw, 64px);
  line-height:1;
  letter-spacing:-.02em;
  color:var(--navy-ink);
  font-variant-numeric:tabular-nums;
}
.ab-glance__label{ display:block; margin-top:8px; font-size:13px; color:var(--ink-muted); }
.ab-glance__creds{
  grid-column:1 / -1;
  margin:clamp(32px, 5vh, 48px) 0 0;
  padding:22px 0 0;
  list-style:none;
  display:flex;
  flex-wrap:wrap;
  gap:12px 32px;
}
.ab-glance__creds li{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:11px;
  font-weight:600;
  letter-spacing:.09em;
  text-transform:uppercase;
  color:var(--navy);
}
.ab-glance__creds li::before{
  content:"";
  flex:none;
  width:5px; height:5px;
  border-radius:50%;
  background:var(--red);
}

/* =========================================================
   3. What drives us
   ========================================================= */
.ab-drives__grid{
  margin-top:clamp(36px, 5vh, 56px);
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:20px;
}
.ab-drive{ min-height:300px; }
.ab-drive__top{ display:flex; align-items:center; gap:18px; }
.ab-drive__icon{ display:inline-flex; color:var(--blue); }
.ab-drive__icon svg{ width:30px; height:30px; }

/* =========================================================
   4. Strategy — split panel
   ========================================================= */
.ab-split{
  margin-top:clamp(36px, 5vh, 56px);
  display:grid;
  grid-template-columns:1fr 1fr;
  min-height:560px;
  border-radius:var(--radius-sm);
  overflow:hidden;
}
.ab-split__panel{
  display:flex;
  flex-direction:column;
  gap:clamp(56px, 10vh, 120px);
  padding:clamp(28px, 3.4vw, 48px);
  color:var(--navy-ink);
}
.ab-split__panel--navy{ --ab-pastel:#e4eefa; background:var(--ab-pastel); --m-bg:var(--ab-pastel); }
.ab-split__panel--red{ --ab-pastel:#fce8e6; background:var(--ab-pastel); --m-bg:var(--ab-pastel); }
.ab-split__top{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
.ab-split__motif{ flex:none; width:72px; height:72px; }
.ab-split__title{
  margin:0 0 24px;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(26px, 2.6vw, 36px);
  line-height:1.15;
  letter-spacing:-.01em;
}
.ab-split__list{ margin:0; padding:0; list-style:none; }
.ab-split__list li{
  display:grid;
  grid-template-columns:44px 1fr;
  gap:12px;
  padding:16px 0;
  border-top:1px solid rgba(15,46,85,.14);
  font-size:15px;
  line-height:1.5;
}
.ab-split__list .ab-num{ padding-top:1px; }
.ab-split__chips{ margin:0; padding:0; list-style:none; display:flex; flex-wrap:wrap; gap:8px; }
.ab-split__chips li{
  padding:9px 15px;
  border-radius:999px;
  background:rgba(255,255,255,.55);
  font-size:13px;
  line-height:1.3;
  transition:background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.ab-split__chips li:hover{ background:var(--white); border-color:var(--red); color:var(--red-dark); }

/* Programme pages — the "focus" section reuses the same asymmetric
   aside-grid layout as AboutFaq/AboutGetInvolved (ab-split__list reused
   as the list on the right, outside a pastel panel) instead of a
   centered header, so a tile-filled hero isn't followed by an empty
   margin either side of a narrow centered list. */
.ab-focus__list{ margin:0; }
.ab-focus__list li a{
  color:var(--navy-ink);
  text-decoration:underline;
  text-decoration-color:rgba(15,46,85,.25);
  text-underline-offset:3px;
  transition:color var(--dur-fast) var(--ease), text-decoration-color var(--dur-fast) var(--ease);
}
.ab-focus__list li a:hover{ color:var(--red-dark); text-decoration-color:var(--red); }
.ab-focus__initiatives{ margin-top:40px; }
.ab-focus__initiatives-label{ margin:0 0 12px; font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-muted); }
.ab-focus__initiatives ul{ margin:0; padding:0; list-style:none; display:flex; flex-wrap:wrap; gap:20px 32px; }

/* One pastel tone per programme (2026-09-30, at Yv’s call), on top of the
   plain .ab-aside-grid__head above — reuses the --ab-pastel/--m-bg
   convention already set by .ab-split__panel--navy/--red elsewhere
   (AboutStrategy/InvolvedWays) rather than inventing a new one, but as
   its own class scoped to ProgrammeFocus.js only: the aside-grid head is
   also shared by AboutFaq/AboutGetInvolved, which never get this class
   and so stay exactly as they were. Two extra tones (lavender, green)
   cover the programmes that don’t already have a natural fit among the
   existing navy/red. Revert: drop the two ab-focus-panel* classes from
   ProgrammeFocus.js’s header and the "tone" field from each programme’s
   focus object in lib/content.js — these rules simply stop matching. */
.ab-focus-panel{
  background:var(--ab-pastel);
  --m-bg:var(--ab-pastel);
  padding:clamp(24px, 3vw, 32px);
  border-radius:var(--radius-sm);
}
.ab-focus-panel--red{ --ab-pastel:#fce8e6; }
.ab-focus-panel--navy{ --ab-pastel:#e4eefa; }
.ab-focus-panel--lavender{ --ab-pastel:#ece7fb; }
.ab-focus-panel--green{ --ab-pastel:#e3f3ea; }
.ab-focus-panel--amber{ --ab-pastel:#fdf3dd; }

/* Same per-programme accent, on the page hero this time (2026-09-30):
   a top-to-bottom gradient from the programme's pastel tone (solid for
   the top 35% of the section) fading to white by 65%, so the hero
   itself signals which programme the visitor is on rather than staying
   identical across all 5. .ab-hero is otherwise unstyled (no background
   of its own — see .ab-hero__grid above for its padding), so this never
   overrides anything: it only ever adds a background where none existed.
   Passed as an optional "tone" prop on <InvolvedHero>, only from the 5
   app/programmes/<slug>/page.js files — the /programmes hub and the
   Intern/Volunteer detail pages (which also use InvolvedHero) pass no
   tone and keep their plain white hero. Revert: drop the "tone" prop
   passed to <InvolvedHero> in those 5 files (and the tone param on
   InvolvedHero.js itself) — these rules stop matching. */
.ab-hero--red{ background:linear-gradient(180deg, #fce8e6 0%, #fce8e6 15%, var(--white) 100%); }
.ab-hero--navy{ background:linear-gradient(180deg, #e4eefa 0%, #e4eefa 15%, var(--white) 100%); }
.ab-hero--lavender{ background:linear-gradient(180deg, #ece7fb 0%, #ece7fb 15%, var(--white) 100%); }
.ab-hero--green{ background:linear-gradient(180deg, #e3f3ea 0%, #e3f3ea 15%, var(--white) 100%); }
.ab-hero--amber{ background:linear-gradient(180deg, #fdf3dd 0%, #fdf3dd 15%, var(--white) 100%); }

/* =========================================================
   5–8. Aside layouts (Who we are, FAQ, Get involved)
   ========================================================= */
.ab-aside-grid{
  display:grid;
  grid-template-columns:repeat(12, minmax(0, 1fr));
  column-gap:var(--ab-col-gap);
}
.ab-aside-grid__head{
  grid-column:1 / span 4;
  align-self:start;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
}
.ab-aside-grid__head .ab-link{ margin-top:18px; }
/* Sticky only when the list beside it is long enough to need it (AboutFaq
   measures it and sets data-sticky); a sticky grid item naturally lets go
   once the bottom of its grid area is reached, so normal scrolling resumes
   after the last question. */
.ab-aside-grid__head[data-sticky="true"]{ position:sticky; top:32px; }
.ab-aside-grid__motif{ width:112px; height:112px; margin-top:clamp(28px, 5vh, 48px); }
.ab-aside-grid__main{ grid-column:6 / -1; margin:0; padding:0; list-style:none; }

/* Who we are */
.ab-row{
  display:grid;
  grid-template-columns:44px 1fr;
  gap:24px;
  padding:32px 0;
}
.ab-row__body{ display:flex; flex-direction:column; align-items:flex-start; }
.ab-row__num{
  font-family:var(--font-sans);
  font-weight:800;
  font-size:clamp(48px, 5vw, 72px);
  line-height:1;
  letter-spacing:-.02em;
  color:var(--navy-ink);
  font-variant-numeric:tabular-nums;
}
.ab-row__label{ margin-top:8px; font-size:13px; color:var(--ink-muted); }
.ab-row__text{ margin-top:14px; max-width:52ch; font-size:14px; line-height:1.6; color:var(--ink-muted); }
.ab-row .ab-link{ margin-top:16px; }
.ab-row:hover .ab-circle{ border-color:var(--navy-ink); }

/* Where We Work hub — country list + interactive map
   (components/WhereWeWorkList.js), reusing .reach__list/.reach__col/
   .reach__map/.reach__geo/.reach__marker from the homepage's Reach
   section wholesale (see those rules above): same two elements, just in
   a [list, map] row instead of Reach's [intro, map, list] row, under
   this page's own centered SectionHead. .reach__inner already provides
   the flex row + the 1100px/640px responsive wrap/stack behaviour, so
   .ww-countries-row only adds the top margin below the header. */
.ww-countries-row{
  margin:clamp(36px, 5vh, 56px) 0 0;
  /* Override .reach__inner's align-items:center (shared with the
     homepage Reach section, so not changed there): the map column's
     height now varies with the hover/detail panel's content (0/1/2
     recent stories per country — see .ww-map-detail below), and
     vertical centering would otherwise reflow the country list itself
     every time that panel's content changes height, shifting list items
     out from under the pointer mid-hover/mid-click. */
  align-items:flex-start;
}
.ww-list .reach__col a{ font-size:16px; color:var(--navy-ink); }
.ww-list .reach__col a:hover{ color:var(--blue); }

/* Persistent "this is the applied filter" state, distinct from the
   transient hover/focus preview (.is-active, shared with the homepage's
   Reach section above — see components/WhereWeWorkList.js). Given the
   same treatment as .is-active rather than a third color, since both
   mean "this is the one in focus" to the visitor. */
.reach__col li.is-selected{ color:var(--blue); font-weight:600; }
.reach__geo.is-selected{ fill:#d7e0e8; }
.reach__marker.is-selected .reach__marker-ring{ opacity:.18; }
.reach__marker.is-selected .reach__marker-dot{ fill:var(--red); }

/* Issues category chips — filters the same grid as the map/list above,
   see getWhereWeWorkPage()'s note on the Where We Work × Issues merge. */
.ww-issues{
  margin:clamp(28px, 4vh, 40px) 0 0;
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}
.ww-chip{
  display:inline-flex;
  align-items:center;
  padding:9px 16px;
  border-radius:999px;
  border:1px solid rgba(15,46,85,.16);
  background:#fff;
  font-size:13px;
  font-weight:600;
  color:var(--ink-muted);
  text-decoration:none;
  transition:border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
    background-color var(--dur-fast) var(--ease);
}
.ww-chip:hover{ border-color:var(--blue); color:var(--blue); }
.ww-chip.is-selected{ border-color:var(--navy); background:var(--navy); color:#fff; }
.ww-chip.is-selected:hover{ color:#fff; }

.ww-filter-summary{
  margin:16px 0 0;
  font-size:13.5px;
  color:var(--ink-muted);
}
.ww-filter-summary a{ color:var(--blue); font-weight:600; text-decoration:none; }
.ww-filter-summary a:hover{ text-decoration:underline; }

.ww-results{ margin-top:clamp(28px, 4vh, 40px); }

/* Map restyle (2026-09-25) inspired by pressattack.africa/tracker, at
   Yv's request. MFWA's WordPress content has no per-incident data (no
   severity/gender/assailant fields, country-level only), so this keeps
   the existing article model and borrows only the tracker's LOOK: a
   choropleth shaded by how much has been published (bucketed relative to
   the busiest country in the current filter — see getWhereWeWorkPage()'s
   severityOf()), a legend, a hover/detail panel with "recent stories",
   and a stat strip. Severity fill/stroke itself is set with inline
   styles in WhereWeWorkList.js (not classes here), specifically so it
   can't leak into the homepage Reach section above, which shares the
   .reach__geo/.reach__marker-dot markup and keeps its original flat
   fill/hover rules untouched. */
.ww-stats{
  list-style:none;
  margin:clamp(20px, 3vh, 28px) 0 0;
  padding:0;
  display:flex;
  flex-wrap:wrap;
  gap:clamp(20px, 4vw, 40px);
}
.ww-stat{ flex:1 1 160px; }
.ww-stat__num{
  display:block;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(20px, 2.2vw, 28px);
  color:var(--navy-ink);
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}
.ww-stat__label{ display:block; margin-top:4px; font-size:12.5px; color:var(--ink-muted); }

.ww-sev-dot{
  display:inline-block;
  width:8px;
  height:8px;
  border-radius:50%;
  margin-right:8px;
  vertical-align:middle;
  flex:none;
}

.ww-map-panel{
  /* Yv moved this out from under the map to sit beside it as a third
     .reach__inner column (list | map | panel) — it needs its own
     flex-basis now, and critically `min-width:0` to override flexbox's
     default min-width:auto, which is what was forcing this column (and
     the whole row) to stretch/overflow to fit the recent-story text at
     its unwrapped intrinsic width instead of wrapping within its share
     of the row. */
  flex:1 1 220px;
  min-width:0;
  max-width:260px;
  padding-left:20px;
  border-left:1px solid var(--hairline);
}
@media (max-width:1100px){
  .ww-countries-row .ww-map-panel{
    flex:1 1 100%;
    max-width:none;
    padding-left:0;
    border-left:none;
    border-top:1px solid var(--hairline);
    padding-top:14px;
    margin-top:8px;
  }
}
.ww-legend{
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  font-size:11.5px;
  color:var(--ink-muted);
}
.ww-legend li{ display:flex; align-items:center; }
.ww-legend__swatch{
  display:inline-block;
  width:10px;
  height:10px;
  border-radius:3px;
  margin-right:6px;
}
/* Fixed (not min-) height, sized for the fullest case (name + meta +
   2 recent-story rows, each up to 2 lines now that this column is
   narrower than the old full-width-under-the-map layout — see
   .ww-map-detail__recent a's wrapping below): keeps this panel's own box
   from changing size as its content changes with the hovered country,
   on top of the align-items fix above — belt and suspenders against the
   same reflow. */
.ww-map-detail{ margin-top:14px; height:160px; overflow:hidden; }
.ww-map-detail__name{ margin:0; font-weight:700; color:var(--navy-ink); font-size:15px; }
.ww-map-detail__meta{
  margin:4px 0 0;
  display:flex;
  align-items:center;
  font-size:12.5px;
  color:var(--ink-muted);
}
.ww-map-detail__recent{ list-style:none; margin:10px 0 0; padding:0; display:flex; flex-direction:column; gap:8px; }
.ww-map-detail__recent li{ display:flex; gap:10px; font-size:12.5px; }
/* flex:1 1 auto + min-width:0 (not the shared row's overflow problem,
   but the same underlying flexbox default) lets a long story title wrap
   inside its share of this narrow column instead of forcing the <li>
   wider than the panel; the date keeps its natural width via flex:none
   on the span below rather than justify-content:space-between, which
   can't coexist with a wrapping first child. */
.ww-map-detail__recent a{ flex:1 1 auto; min-width:0; overflow-wrap:break-word; color:var(--blue); text-decoration:none; }
.ww-map-detail__recent a:hover{ text-decoration:underline; }
.ww-map-detail__recent span{ flex:none; color:var(--ink-muted); }
.ww-map-detail__empty,
.ww-map-detail__hint{ margin:4px 0 0; font-size:12.5px; color:var(--ink-muted); }

/* Networks */
.ab-networks__grid{
  margin:clamp(36px, 5vh, 56px) 0 0;
  padding:0;
  list-style:none;
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:20px;
}
.ab-networks__grid > li{ display:flex; }
.ab-network{ flex:1 1 auto; min-height:280px; }
.ab-network__top{ display:flex; align-items:center; justify-content:space-between; }
.ab-network__icon{ display:inline-flex; color:var(--blue); }
.ab-network__icon svg{ width:24px; height:24px; transition:transform .6s var(--ease); }
.ab-network:hover .ab-network__icon svg{ transform:rotate(-30deg); }
.ab-network__arrow{ margin-top:auto; padding-top:24px; color:var(--navy); }
.ab-network__arrow svg{ transition:transform var(--dur-fast) var(--ease); }
.ab-network:hover .ab-network__arrow svg{ transform:translateX(4px); }

/* Our Partners — funding-partner logo grid */
.ab-logos{
  margin:clamp(36px, 5vh, 56px) 0 0;
  padding:0;
  list-style:none;
  display:grid;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  gap:20px;
}
.ab-logo{
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:120px;
  padding:24px;
  background:#f9fafa;
  border-radius:var(--radius-sm);
  transition:transform var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease);
}
.ab-logo:hover{ transform:translateY(-4px); box-shadow:0 18px 34px -22px rgba(15,46,85,.35); }
.ab-logo img{ max-width:100%; max-height:56px; width:auto; height:auto; object-fit:contain; }

/* Our Partners — national-partner directory grid */
.ab-partners{
  margin:clamp(36px, 5vh, 56px) 0 0;
  padding:0;
  list-style:none;
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));
  gap:20px;
}
.ab-partner{ min-height:220px; }
.ab-card__title--sm{ font-size:clamp(17px, 1.4vw, 19px); margin-top:16px; }
.ab-partner__text{ max-width:none; }

/* FAQ */
.ab-faq__q{ margin:0; }
.ab-faq__q button{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
  padding:24px 0;
  text-align:left;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(18px, 1.6vw, 22px);
  line-height:1.3;
  color:var(--navy-ink);
}
.ab-faq__q button:hover .ab-faq__icon{ border-color:var(--navy-ink); }
.ab-faq__item.is-open .ab-faq__icon{ background:var(--navy-ink); border-color:var(--navy-ink); color:var(--white); }
.ab-faq__item.is-open .ab-faq__icon svg{ transform:rotate(45deg); }
.ab-faq__icon svg{ width:14px; height:14px; }
.ab-faq__panel{
  display:grid;
  grid-template-rows:0fr;
  visibility:hidden;
  transition:grid-template-rows .45s var(--ease), visibility 0s linear .45s;
}
.ab-faq__item.is-open .ab-faq__panel{
  grid-template-rows:1fr;
  visibility:visible;
  transition:grid-template-rows .45s var(--ease), visibility 0s;
}
.ab-faq__inner{ overflow:hidden; }
.ab-faq__inner p{ margin:0 0 26px; max-width:64ch; font-size:15px; line-height:1.7; color:var(--ink-muted); }

/* Get involved — dark band, cf. .cta */
.ab-involve{
  --m-a:var(--white);
  --m-b:var(--red);
  --m-c:#5b86c7;
  --m-bg:var(--navy-panel);
  background:var(--navy-panel);
  color:var(--white);
}
.ab-involve .eyebrow,
.ab-involve .ab-h2{ color:var(--white); }
.ab-involve .ab-head__text{ color:rgba(255,255,255,.78); }
.ab-involve .ab-link{ color:var(--white); }
.ab-involve__list{ display:grid; gap:16px; }
.ab-action{
  display:grid;
  grid-template-columns:1fr auto;
  grid-template-rows:1fr auto;
  gap:24px;
  min-height:200px;
  padding:clamp(24px, 2.6vw, 32px);
  border:1px solid rgba(255,255,255,.16);
  border-radius:var(--radius-sm);
  transition:background-color var(--dur-slow) var(--ease), border-color var(--dur-slow) var(--ease);
}
.ab-action:hover{ background:rgba(255,255,255,.05); border-color:rgba(255,255,255,.34); }
.ab-action__title{
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(28px, 3vw, 40px);
  line-height:1.1;
  letter-spacing:-.015em;
  color:var(--white);
}
.ab-action__arrow{
  align-self:start;
  justify-self:end;
  display:grid;
  place-items:center;
  width:40px; height:40px;
  color:var(--white);
  transition:transform var(--dur-slow) var(--ease), color var(--dur-fast) var(--ease);
}
.ab-action:hover .ab-action__arrow{ transform:rotate(45deg); color:var(--red); }
.ab-action .ab-num{ align-self:end; color:rgba(255,255,255,.6); }
.ab-action__desc{
  align-self:end;
  justify-self:end;
  max-width:36ch;
  font-size:13.5px;
  line-height:1.6;
  color:rgba(255,255,255,.72);
}

/* =========================================================
   Responsive
   ========================================================= */
@media (max-width:1100px){
  .ab-networks__grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
  .ab-logos{ grid-template-columns:repeat(3, minmax(0, 1fr)); }
  .ab-tiles{ grid-column:7 / -1; }
}
@media (max-width:900px){
  .ab-hero__copy{ grid-column:1 / -1; }
  .ab-tiles{
    grid-column:1 / -1;
    grid-row:2;
    justify-self:start;
    max-width:480px;
    margin-top:44px;
  }

  .ab-glance__panel{ row-gap:32px; }
  .ab-glance__intro,
  .ab-glance__stats,
  .ab-glance__creds{ grid-column:1 / -1; }
  .ab-glance__creds{ margin-top:0; }
  .ab-glance__motif{ display:none; }

  .ab-drives__grid{ grid-template-columns:1fr; }
  .ab-drive{ min-height:0; }

  .ab-split{ grid-template-columns:1fr; min-height:0; }
  .ab-split__panel{ min-height:420px; }

  .ab-aside-grid__head,
  .ab-aside-grid__main{ grid-column:1 / -1; }
  .ab-aside-grid__head[data-sticky="true"]{ position:relative; top:auto; }
  .ab-aside-grid__main{ margin-top:36px; }
  .ab-aside-grid__motif{ display:none; }

  .ab-head--split{ flex-direction:column; align-items:flex-start; }
  .ab-head__motif{ display:none; }
}
@media (max-width:600px){
  .ab-hero__title{ font-size:clamp(34px, 9.6vw, 42px); }
  .ab-hero__line{ display:inline; }
  .ab-networks__grid{ grid-template-columns:1fr; }
  .ab-network{ min-height:0; }
  .ab-logos{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
  .ab-partners{ grid-template-columns:1fr; }
  .ab-partner{ min-height:0; }
  .ab-action{ min-height:0; grid-template-rows:auto auto auto; }
  .ab-action .ab-num{ grid-row:3; }
  .ab-action__desc{ grid-row:2; grid-column:1 / -1; justify-self:start; }
}

/* =========================================================
   About › Our staff
   Same frame as /about-us (see "About Us" above): borderless cards on
   soft backgrounds, homepage .topics filter, serif names, blue tags.
   ========================================================= */
.ab-crumbs{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:22px;
  font-size:13px;
  color:var(--ink-muted);
}
.ab-crumbs a{ font-weight:600; color:var(--blue); }
.ab-crumbs a:hover{ text-decoration:underline; text-underline-offset:3px; }
.ab-crumbs i{ margin-right:10px; font-style:normal; color:var(--hairline); }

/* Hero tiles: one per team, with its head-count */
.st-tiles{ margin-top:0; margin-bottom:0; padding:0; list-style:none; max-width:540px; }
.st-tile{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  padding:clamp(14px, 1.6vw, 22px);
}
.ab-tile.st-tile .motif{ width:40%; height:40%; }
.st-tile__num{
  margin-top:auto;
  font-family:var(--font-sans);
  font-weight:800;
  font-size:clamp(28px, 2.6vw, 40px);
  line-height:1;
  letter-spacing:-.02em;
  color:var(--m-a);
  font-variant-numeric:tabular-nums;
}
.st-tile__label{
  min-height:2.6em; /* two lines, so every count sits on the same baseline */
  margin-top:6px;
  line-height:1.3;
  font-size:11px;
  font-weight:600;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--m-a);
  opacity:.75;
}

/* Our Staff hero photo (2026-09-27, replaces that hero's tile grid — see
   the note in StaffHero.js; .st-tiles/.st-tile above are untouched,
   still used by BoardHero.js). The wrapping element keeps the plain
   .ab-tiles class for the same grid slot/positioning AboutHero/BoardHero/
   InvolvedHero's tile grids use (column 8/-1, row 1, justify-self:end,
   stacking below the copy at <=900px — see .ab-tiles' own responsive
   rules) — only the content inside that slot changes here. */
.st-photo{ overflow:hidden; }
/* .ab-tiles is a 3-column grid (for the team-count tiles on Board/
   Involved heroes) — override to a plain block here so the single
   photo isn't auto-placed into just the first of those 3 tracks. */
.ab-tiles.st-photo{ display:block; }
.st-photo__img{
  display:block;
  width:100%;
  aspect-ratio:16 / 9; /* close to the old 3-column tile grid's overall shape */
  object-fit:cover;
}

/* Directory */
.st-count{ flex:none; margin:0; font-size:13px; color:var(--ink-muted); }
.st-count b{
  margin-right:6px;
  font-family:var(--font-sans);
  font-weight:800;
  font-size:28px;
  color:var(--navy-ink);
  font-variant-numeric:tabular-nums;
}
.st-topics{ margin-top:clamp(28px, 4vh, 40px); }
.st-topics .topics__item.is-active{ color:var(--red); }
.st-topics__n{ margin-left:2px; font-size:10px; font-weight:600; color:var(--ink-muted); }

.st-grid{
  margin:clamp(32px, 5vh, 48px) 0 0;
  padding:0;
  list-style:none;
  display:grid;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  gap:40px 20px;
}
.st-grid__item{
  animation:stIn .55s var(--ease) both;
  animation-delay:calc(var(--i, 0) * 40ms);
}
@keyframes stIn{
  from{ opacity:0; transform:translateY(16px); }
  to{ opacity:1; transform:none; }
}
.st-card{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  width:100%;
  padding:0;
  text-align:left;
}
.st-card__media{
  position:relative;
  display:block;
  width:100%;
  aspect-ratio:570 / 696;
  overflow:hidden;
  border-radius:var(--radius-sm);
  background:#f9fafa;
}
.st-card__media img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:top center;
  transition:transform .7s var(--ease), opacity var(--dur-slow) var(--ease);
}
.st-card__media::after{
  content:"View profile";
  position:absolute;
  left:12px;
  bottom:12px;
  padding:7px 12px;
  border-radius:var(--radius-sm);
  background:var(--white);
  font-size:11px;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--navy-ink);
  opacity:0;
  transform:translateY(8px);
  transition:opacity var(--dur-fast) var(--ease), transform var(--dur-slow) var(--ease);
}
.st-card:hover .st-card__media img,
.st-card:focus-visible .st-card__media img{ transform:scale(1.045); }
.st-card:hover .st-card__media::after,
.st-card:focus-visible .st-card__media::after{ opacity:1; transform:none; }
.st-card__team{ margin-top:16px; }
.st-card__name{
  margin-top:6px;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:18px;
  line-height:1.3;
  color:var(--navy-ink);
  transition:color var(--dur-fast) var(--ease);
}
.st-card:hover .st-card__name{ color:var(--blue); }
.st-card__role{ margin-top:4px; font-size:13px; line-height:1.45; color:var(--ink-muted); }

/* Profile sheet (portalled to <body>, so it redeclares what it borrows
   from .about) */
.st-sheet{
  --ab-line:var(--hairline);
  position:fixed;
  inset:0;
  z-index:1000;
  color:var(--navy);
}
.st-sheet.is-closing{ pointer-events:none; }
.st-sheet__backdrop{
  position:absolute;
  inset:0;
  background:rgba(9, 23, 33, .55);
  animation:stFadeIn .45s var(--ease) both;
}
.st-sheet.is-closing .st-sheet__backdrop{ animation:stFadeOut .45s var(--ease) both; }
@keyframes stFadeIn{ from{ opacity:0; } to{ opacity:1; } }
@keyframes stFadeOut{ from{ opacity:1; } to{ opacity:0; } }
.st-sheet__panel{
  position:absolute;
  left:0; right:0; bottom:0;
  height:70vh;
  display:flex;
  flex-direction:column;
  background:var(--white);
  border-radius:var(--radius-sm) var(--radius-sm) 0 0;
  box-shadow:0 -24px 60px -24px rgba(9, 23, 33, .4);
  animation:stSheetIn .5s cubic-bezier(.22, .8, .24, 1) both;
}
.st-sheet.is-closing .st-sheet__panel{ animation:stSheetOut .45s cubic-bezier(.5, 0, .75, 0) both; }
@keyframes stSheetIn{ from{ transform:translateY(100%); } to{ transform:none; } }
@keyframes stSheetOut{ from{ transform:none; } to{ transform:translateY(100%); } }
.st-sheet__grip{
  position:absolute;
  top:8px;
  left:50%;
  width:44px;
  height:4px;
  margin-left:-22px;
  border-radius:2px;
  background:var(--hairline);
}
.st-sheet__bar{
  flex:none;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:22px var(--gutter) 16px;
  background-image:radial-gradient(circle, var(--hairline) 1px, transparent 1.5px);
  background-size:6px 2px;
  background-position:bottom left;
  background-repeat:repeat-x;
}
.st-sheet__count{ margin:0; font-size:13px; color:var(--ink-muted); }
.st-sheet__count b{ font-family:var(--font-sans); font-weight:800; font-size:20px; color:var(--navy-ink); }
.st-sheet__nav{ display:flex; align-items:center; gap:10px; }
.st-sheet__nav .ab-circle:hover{ border-color:var(--navy-ink); }
.st-sheet__nav .ab-circle svg{ width:auto; height:auto; }
.st-sheet__close{ margin-left:8px; background:var(--navy-ink); border-color:var(--navy-ink); color:var(--white); }
.st-sheet__close:hover{ background:var(--red); border-color:var(--red) !important; }

.st-sheet__body{
  flex:1 1 auto;
  min-height:0;
  display:grid;
  grid-template-columns:minmax(200px, 30%) minmax(0, 1fr);
  grid-template-rows:minmax(0, 1fr);
  gap:clamp(24px, 4vw, 64px);
  padding:clamp(20px, 3vh, 32px) var(--gutter);
  animation:stSwap .45s var(--ease) both;
}
@keyframes stSwap{
  from{ opacity:0; transform:translateX(24px); }
  to{ opacity:1; transform:none; }
}
.st-sheet__photo{
