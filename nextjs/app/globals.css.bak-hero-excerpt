/* =========================================================
   Notre présence — « 16 countries. One region. »
   ========================================================= */
.reach{
  background:#f9fafa;
  /*padding:clamp(56px, 8vh, 96px) var(--gutter);*/
  padding:clamp(0px, 0vh, 96px) var(--gutter);
}

.reach__inner{
  display:flex;
  align-items:center;
  gap:clamp(28px, 5vw, 64px);
  justify-content: center;
}

.reach__intro{
  flex:1 1 340px;
  max-width:420px;
}
.reach__title{
  margin:clamp(10px, 1.8vh, 18px) 0 0;
  font-family:var(--font-serif);
  font-weight:600;
  font-size:clamp(28px, 3vw, 38px);
  line-height:1.16;
  letter-spacing:-.015em;
  color:var(--navy-ink);
}
.reach__text{
  margin:clamp(14px, 2vh, 20px) 0 0;
  max-width:36ch;
  font-size:14.5px;
  line-height:1.65;
  color:var(--ink-muted);
}
.reach__link{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-top:16px;
  font-size:13px;
  font-weight:600;
  color:var(--blue);
}
.reach__link svg{ flex:none; transition:transform var(--dur-fast) var(--ease); }
.reach__link:hover svg{ transform:translateX(4px); }

/* -- Carte ------------------------------------------------- */
.reach__map{
  flex:1.1 1 380px;
  max-width:480px;
}
.reach__map svg{ width:100%; height:auto; display:block; overflow:hidden; }

/* Base country fill (uncovered land, decorative context) */
.reach__geo{
  fill:#e9edf1;
  stroke:#fff;
  stroke-width:.75;
  outline:none;
}
/* One of MFWA's 16 countries — same fill as the rest of the map on
   purpose (the reference design tells covered countries apart with the
   marker dots only, not a fill difference), but clickable/hoverable. */
.reach__geo.is-covered{
  cursor:pointer;
  fill:var(--geo-soft, #e9edf1);
  transition:fill var(--dur-fast) var(--ease);
}
.reach__geo.is-covered:hover,
.reach__geo.is-active{
  fill:var(--geo-strong, #d7e0e8);
}
/* 2026-10-20 (Yv) : pastel semi-transparent par pays — couleur du drapeau,
   voir components/Reach.js et lib/content.js getReach(). */
.reach__marker-halo{ pointer-events:none; transition:r var(--dur-fast) var(--ease), fill var(--dur-fast) var(--ease); }

.reach__marker{ cursor:pointer; outline:none; }
.reach__marker-ring{
  fill:var(--blue);
  opacity:0;
  transition:opacity var(--dur-fast) var(--ease), r var(--dur-fast) var(--ease);
}
.reach__marker-dot{
  fill:var(--navy);
  stroke:#fff;
  stroke-width:1.2;
  transition:fill var(--dur-fast) var(--ease), r var(--dur-fast) var(--ease);
}
.reach__marker:hover .reach__marker-ring,
.reach__marker.is-active .reach__marker-ring{ opacity:.18; }
.reach__marker:hover .reach__marker-dot,
.reach__marker.is-active .reach__marker-dot{ fill:var(--red); }

/* -- Liste des pays ------------------------------------------ */
.reach__list{
  flex:0 0 auto;
  display:flex;
  gap:clamp(28px, 4vw, 56px);
}
.reach__col{
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  flex-direction:column;
  gap:14px;
}
.reach__col li{
  font-size:14.5px;
  color:var(--ink-muted);
  transition:color var(--dur-fast) var(--ease);
}
.reach__col li.is-active{
  color:var(--blue);
  font-weight:600;
}
.reach__col a{
  display:block;
  color:inherit;
  text-decoration:none;
  cursor:pointer;
}

/* -- Responsive ---------------------------------------------- */
@media (max-width:1100px){
  .reach__inner{ flex-wrap:wrap; }
  .reach__intro{ flex:1 1 100%; max-width:none; }
  .reach__map{ flex:1 1 340px; }
}

@media (max-width:640px){
