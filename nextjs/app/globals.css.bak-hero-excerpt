/* =========================================================
   /programmes — illustration isométrique (2026-10-17, demande de Yv)
   4 cubes (un par programme) au-dessus d'une dalle, SVG pur.
   Revert: retirer la prop `art` dans app/programmes/page.js — ces règles
   deviennent inertes (les tuiles reviennent). Sauvegardes .bak-iso-hero.
   ========================================================= */
.ab-hero__art{
  grid-column:8 / -1;
  grid-row:1;
  justify-self:end;
  width:100%;
  max-width:520px;
}
.iso{
  --iso-s:32px;
  --iso-ink:var(--navy-ink);
  margin:0;
  position:relative;
  color:var(--iso-ink);
  /* repère discret façon papier millimétré, comme sur la référence */
  background-image:
    linear-gradient(to right, rgba(19,49,92,.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(19,49,92,.06) 1px, transparent 1px);
  background-size:28px 28px;
  border-radius:var(--radius-sm);
}
.iso__svg{ display:block; width:100%; height:auto; overflow:visible; }

.iso .iso-face{ stroke:var(--iso-ink); stroke-width:1.3; stroke-linejoin:round; vector-effect:non-scaling-stroke; }
.iso .iso-line{ fill:none; stroke:var(--iso-ink); stroke-width:1; stroke-linejoin:round; stroke-linecap:round; vector-effect:non-scaling-stroke; opacity:.55; }
.iso .iso-line--dashed{ stroke-dasharray:5 5; opacity:.45; }

/* dalle */
.iso .iso-slab .iso-face--slab{ fill:#f6f3ec; }
.iso .iso-slab .iso-face--left{ fill:#e5e0d3; }
.iso .iso-slab .iso-face--right{ fill:#ece8dd; }
.iso .iso-network line,
.iso .iso-network circle{ fill:none; stroke:var(--iso-ink); stroke-width:2.4; stroke-linecap:round; vector-effect:non-scaling-stroke; }
.iso .iso-network__hub{ fill:var(--white); }

/* cubes : une teinte par programme (mêmes pastels que le reste du site) */
.iso-cube{ cursor:pointer; outline:none; }
.iso-cube--red{ --top:#fce8e6; --left:#efc5c0; --right:#f6d6d2; --dot:#e11b22; }
.iso-cube--lavender{ --top:#ece7fb; --left:#d3c9f1; --right:#e0d8f6; --dot:#7a5fd0; }
.iso-cube--navy{ --top:#e4eefa; --left:#c3d6ef; --right:#d4e2f4; --dot:#1b4b8f; }
.iso-cube--green{ --top:#e3f3ea; --left:#bfe0cd; --right:#d2eadb; --dot:#2f9a63; }
.iso-cube .iso-face--top{ fill:var(--top); }
.iso-cube .iso-face--left{ fill:var(--left); }
.iso-cube .iso-face--right{ fill:var(--right); }
.iso-cube .iso-glyph{ fill:none; stroke:var(--iso-ink); stroke-width:3.2; stroke-linecap:round; stroke-linejoin:round; vector-effect:non-scaling-stroke; }
.iso-cube .iso-glyph *{ vector-effect:non-scaling-stroke; }
.iso-cube .iso-hit{ fill:transparent; stroke:none; }
.iso-cube__body{
  transform:translateY(calc(var(--lift, .3) * var(--iso-s) * -1));
  transition:transform .55s cubic-bezier(.2,.8,.2,1);
}
.iso-cube.is-active .iso-face--top{ filter:brightness(1.03); }
.iso-cube:focus-visible .iso-face--top,
.iso-cube:focus-visible .iso-face{ stroke:var(--red); stroke-width:2.2; }

/* légende cliquable (aussi utile au clavier / tactile) */
.iso__legend ul{
  list-style:none;
  margin:18px 0 0;
  padding:0;
  display:grid;
  grid-template-columns:repeat(2, auto);
  gap:6px 28px;
  justify-content:center;
}
.iso__legend-link{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-size:13px;
  font-weight:600;
  color:var(--navy);
  padding:4px 0;
  border-bottom:2px solid transparent;
  transition:border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.iso__legend-link i{ width:10px; height:10px; border-radius:2px; background:var(--dot, var(--navy)); border:1px solid var(--iso-ink); }
.iso__legend-link--red{ --dot:#f4a5a0; }
.iso__legend-link--lavender{ --dot:#b9a8ec; }
.iso__legend-link--navy{ --dot:#8fb2e0; }
.iso__legend-link--green{ --dot:#86cba5; }
.iso__legend-link:hover,
.iso__legend-link.is-active,
.iso__legend-link:focus-visible{ border-bottom-color:var(--red); color:var(--red-dark); }

@media (max-width:1100px){
  .ab-hero__art{ grid-column:7 / -1; }
}
@media (max-width:900px){
  .ab-hero__art{
    grid-column:1 / -1;
    grid-row:2;
    justify-self:center;
    max-width:440px;
    margin-top:36px;
  }
}
@media (prefers-reduced-motion: reduce){
  .iso-cube__body{ transition:none; }
}

/* Section « Impact » de l'accueil, 901–1187px : aspect-ratio 33/10 + min-height 360px forçaient
   la section à 1188px de large (défilement horizontal de la page entière). On garde la hauteur
   minimale mais on laisse la hauteur suivre le contenu. (Constaté le 2026-10-17, déjà présent avant.) */
@media (min-width:901px) and (max-width:1187px){
