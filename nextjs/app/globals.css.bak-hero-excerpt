.ab-stagger[data-reveal="stagger"] > *:nth-child(4){ transition-delay:180ms; }
.ab-stagger[data-reveal="stagger"] > *:nth-child(5){ transition-delay:240ms; }
.ab-stagger[data-reveal="stagger"] > *:nth-child(6){ transition-delay:300ms; }
