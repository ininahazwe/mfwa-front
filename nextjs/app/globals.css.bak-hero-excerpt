  min-height:0;
  overflow-x:auto;
  overflow-y:hidden;
  scroll-snap-type:x mandatory;
  overscroll-behavior-x:contain;
  scrollbar-width:none;
  -webkit-overflow-scrolling:touch;
}
.hero__stories::-webkit-scrollbar{ display:none; }
.hero__stories:focus-visible{ outline:2px solid var(--white); outline-offset:-4px; }
.hero__stories > .hero__story{
  flex:0 0 100%;
