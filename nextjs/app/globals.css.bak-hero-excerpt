/* =========================================================
   Filigrane de catégorie sur les vignettes — « étiquette de carte »
   (2026-10-19, design C choisi par Yv) · components/CategoryMark.js,
   components/StoryMedia.js. Bas de la vignette assombri, faisceau de
   courbes, mot écrit le long d'une courbe ; survol : les courbes se
   redessinent l'une après l'autre et le faisceau s'écarte.
   ========================================================= */
.story__media--bare{ background:#11202f; }
.cmark{
  position:absolute; inset:0;
  width:100%; height:100%;
  z-index:1;
  pointer-events:none;
  overflow:hidden;
}
.cmark__bg path{
  fill:none;
  stroke:#d6e2f0;
  stroke-opacity:.16;
  stroke-width:1;
  vector-effect:non-scaling-stroke;
}
.cmark__line{
  fill:none;
  stroke:#fff;
  stroke-opacity:.42;
  stroke-width:1;
  vector-effect:non-scaling-stroke;
  stroke-linecap:round;
  stroke-dasharray:1 1;
  stroke-dashoffset:0;
  transform:translateY(0);
  transition:transform .6s cubic-bezier(.2,.7,.2,1);
}
.cmark__line--label{ stroke-opacity:.95; stroke-width:1.4; }
.cmark__word{
  font-family:var(--font-serif);
  font-style:italic;
  font-weight:600;
  font-size:24px;
  letter-spacing:.02em;
}
.cmark__marker{
  fill:var(--red);
  transition:transform .45s cubic-bezier(.2,.7,.2,1);
}

/* survol : redessin en cascade + écartement du faisceau */
@keyframes cmark-draw{
  from{ stroke-dashoffset:1; }
  to{ stroke-dashoffset:0; }
}
.story__link:hover .cmark__line,
.story__link:focus-visible .cmark__line{
  animation:cmark-draw .9s cubic-bezier(.45,.05,.25,1) both;
  animation-delay:calc(var(--i) * 45ms);
  transform:translateY(var(--spread));
}
.story__link:hover .cmark__line--label,
.story__link:focus-visible .cmark__line--label{ animation:none; }
.story__link:hover .cmark__marker,
.story__link:focus-visible .cmark__marker{ transform:translateY(-4px); }

@media (prefers-reduced-motion: reduce){
  .story__link:hover .cmark__line,
  .story__link:focus-visible .cmark__line{ animation:none; transform:none; }
  .cmark__line, .cmark__marker{ transition:none; }
}

