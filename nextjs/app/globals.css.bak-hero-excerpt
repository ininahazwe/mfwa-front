/* =========================================================
   /programmes — illustration 2D (2026-10-17, demande de Yv)
   4 panneaux « patchwork », personnages + bandes textiles.
   Composant : components/ProgrammesFlat.js. Revenir à la 3D : dans
   app/programmes/page.js, remplacer ProgrammesFlat par ProgrammesIso.
   Légende partagée avec la 3D (.iso__legend*).
   ========================================================= */
.pflat{ --iso-ink:var(--navy-ink); margin:0; color:var(--iso-ink); }
.pflat__svg{ display:block; width:100%; height:auto; overflow:visible; }

.pf-panel{ cursor:pointer; outline:none; }
.pf-panel__tilt{
  transform:rotate(var(--tilt, 0deg));
  transform-box:fill-box;
  transform-origin:center;
  transition:transform .5s cubic-bezier(.2,.8,.2,1);
}
.pf-panel__shadow{ fill:var(--iso-ink); opacity:0; transition:opacity .3s ease; }
.pf-panel.is-active .pf-panel__shadow{ opacity:1; }
.pf-panel__card{ transition:transform .45s cubic-bezier(.2,.8,.2,1); }
.pf-panel__frame{ fill:none; stroke:var(--iso-ink); stroke-width:1.8; }

/* survol / focus : le panneau se redresse et se soulève sur son ombre décalée */
.pf-panel.is-active .pf-panel__tilt{ transform:rotate(0deg); }
.pf-panel.is-active .pf-panel__card{ transform:translate(-7px, -7px); }
.pflat.is-exploring .pf-panel:not(.is-active) .pf-panel__card{ filter:saturate(.55); }
.pf-panel__card{ transition:transform .45s cubic-bezier(.2,.8,.2,1), filter .3s ease; }
.pf-panel:focus-visible .pf-panel__frame{ stroke:var(--red); stroke-width:3; }

/* petits mouvements propres à chaque scène */
.pf-fx,
.pf-prop{ transform-box:fill-box; transform-origin:center; transition:transform .5s cubic-bezier(.2,.8,.2,1), opacity .4s ease; }
.pf-fx--waves path{ opacity:.35; transition:opacity .3s ease; }
.pf-panel.is-active .pf-fx--waves path{ animation:pf-wave 1.2s ease-in-out infinite; }
.pf-panel.is-active .pf-fx--waves path:nth-child(2){ animation-delay:.15s; }
.pf-panel.is-active .pf-fx--waves path:nth-child(3){ animation-delay:.3s; }
.pf-fx--signal path{ opacity:.35; }
.pf-panel.is-active .pf-fx--signal path{ animation:pf-wave 1.4s ease-in-out infinite; }
.pf-panel.is-active .pf-fx--signal path:nth-child(2){ animation-delay:.2s; }
.pf-panel.is-active .pf-fx--signal path:nth-child(3){ animation-delay:.4s; }
.pf-panel.is-active .pf-prop--paper{ transform:translateY(-4px) rotate(3deg); }
.pf-panel.is-active .pf-fx--talk-a{ transform:translate(10px, 4px); }
.pf-panel.is-active .pf-fx--talk-b{ transform:translate(-10px, 6px) rotate(-4deg); }
@keyframes pf-wave{ 0%, 100%{ opacity:.25; } 50%{ opacity:1; } }

@media (prefers-reduced-motion: reduce){
  .pf-panel__tilt,
  .pf-panel__card,
  .pf-fx,
  .pf-prop{ transition:none; }
  .pf-panel.is-active .pf-fx--waves path,
  .pf-panel.is-active .pf-fx--signal path{ animation:none; opacity:1; }
}

/* =========================================================
   Rapports : navigation latérale (2026-10-18, demande de Yv)
   Inspirée d'une side-nav d'application : bloc titre + sous-titre gris,
   filet, lignes icône + libellé aérées ; l'élément actif n'est marqué
   que par une barre verticale rouge sur le bord gauche (pas de pastille,
   pas de fond plein). Programmes (.reports-tabs) et types
   (.reports-filters) partagent ce style (.reports-side__btn).
   Revert : globals.css.bak-reports-nav + ReportsGrid.js.bak-reports-nav.
   ========================================================= */
.reports-side{
  min-width:0; /* sinon, en mobile, les rangées défilantes élargissent la colonne de la grille */
  position:sticky;
  top:28px;
  display:flex;
  flex-direction:column;
  gap:clamp(28px, 4vh, 40px);
}
.reports-group__head{
  padding:0 0 18px 22px;
  border-bottom:1px solid var(--hairline);
}
.reports-group__title{
  margin:0;
  font-size:19px;
  font-weight:600;
  letter-spacing:-.01em;
  color:var(--navy-ink);
}
.reports-group__sub{
  margin:4px 0 0;
  font-size:15px;
  color:var(--ink-muted);
}
.reports-filters{
  display:flex;
  flex-direction:column;
  padding:10px 0 0;
}
.reports-side__btn{
  position:relative;
  display:grid;
  grid-template-columns:24px minmax(0, 1fr) auto;
  align-items:center;
  column-gap:18px;
  width:100%;
  padding:13px 10px 13px 22px;
  border:0;
  background:none;
  font:inherit;
  font-size:15.5px;
  font-weight:500;
  line-height:1.3;
  text-align:left;
  color:#2b3a4d;
  cursor:pointer;
  transition:color var(--dur-fast) var(--ease);
}
.reports-side__btn::before{
  content:"";
  position:absolute;
  left:0; top:6px; bottom:6px;
  width:3px;
  border-radius:0 2px 2px 0;
  background:var(--red);
  transform:scaleY(0);
  transition:transform var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
}
.reports-side__icon{ display:grid; place-items:center; width:24px; height:24px; color:var(--navy-ink); }
.reports-side__icon svg{ width:22px; height:22px; }
.reports-side__count{
  font-size:12.5px;
  font-weight:600;
  font-variant-numeric:tabular-nums;
  color:var(--ink-muted);
}
.reports-side__btn:hover{ color:var(--navy-ink); }
.reports-side__btn:hover::before{ transform:scaleY(1); background:var(--hairline); }
.reports-side__btn.is-active{ color:var(--navy-ink); font-weight:600; }
.reports-side__btn.is-active::before{ transform:scaleY(1); background:var(--red); }
.reports-side__btn.is-active .reports-side__count{ color:var(--red-dark); }
.reports-side__btn.is-dim{ opacity:.45; }
.reports-side__btn:focus-visible{ outline:2px solid var(--blue); outline-offset:-2px; }

@media (max-width:900px){
  .reports-side{ position:static; gap:22px; }
  .reports-group__head{ padding:0 0 12px; display:flex; align-items:baseline; gap:12px; }
  .reports-group__title{ font-size:16px; }
  .reports-group__sub{ margin:0; font-size:13.5px; }
  .reports-filters{
    flex-direction:row;
    gap:4px;
    padding:0;
    overflow-x:auto;
    scrollbar-width:none;
    border-bottom:1px solid var(--hairline);
  }
  .reports-filters::-webkit-scrollbar{ display:none; }
  .reports-side__btn{
    width:auto;
    flex:none;
    grid-template-columns:20px auto auto;
    column-gap:10px;
    padding:14px 12px;
    font-size:14.5px;
    white-space:nowrap;
  }
  .reports-side__icon svg{ width:19px; height:19px; }
  .reports-side__btn::before{ left:10px; right:10px; top:auto; bottom:0; width:auto; height:3px; border-radius:2px 2px 0 0; transform:scaleX(0); }
  .reports-side__btn:hover::before,
  .reports-side__btn.is-active::before{ transform:scaleX(1); }
}

/* -- Onglets programmes : rangée horizontale au-dessus de la grille (2026-10-18, demande de Yv) -- */
.reports-tabs{
  display:flex;
  gap:4px;
  margin:0 0 clamp(24px, 3.5vh, 34px);
  overflow-x:auto;
  scrollbar-width:none;
  border-bottom:1px solid var(--hairline);
}
.reports-tabs::-webkit-scrollbar{ display:none; }
.reports-tabs .reports-side__btn{
  width:auto;
  flex:none;
  grid-template-columns:20px auto auto;
  column-gap:10px;
  padding:14px 14px 15px;
  font-size:15px;
  white-space:nowrap;
}
.reports-tabs .reports-side__icon svg{ width:20px; height:20px; }
.reports-tabs .reports-side__btn::before{
  left:10px; right:10px; top:auto; bottom:-1px;
  width:auto; height:3px;
  border-radius:2px 2px 0 0;
  transform:scaleX(0);
}
.reports-tabs .reports-side__btn:hover::before,
.reports-tabs .reports-side__btn.is-active::before{ transform:scaleX(1); }
/* ≤1180px : rangée défilante horizontale (règles de base ci-dessus) ; au-delà, tout tient sur une ligne */
@media (max-width:1180px){
  /* fondu discret sur les bords : indique qu'on peut faire défiler */
  .reports-tabs{
    -webkit-mask-image:linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 28px), transparent 100%);
            mask-image:linear-gradient(to right, transparent 0, #000 18px, #000 calc(100% - 28px), transparent 100%);
  }
}
@media (min-width:1181px){
  /* une seule rangée : les onglets aux libellés longs se resserrent et passent
     sur deux lignes plutôt que de déborder ou de créer une seconde rangée */
  .reports-tabs{
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:auto; /* colonnes « auto » : chacune grandit jusqu'à sa largeur naturelle,
                               les libellés longs ne se resserrent qu'en dernier */
    justify-content:start;
    overflow:visible;
    gap:0;
  }
  .reports-tabs .reports-side__btn{
    grid-template-columns:20px auto auto;
    justify-content:start;
    column-gap:9px;
    padding:12px 14px 13px;
    font-size:14.5px;
    line-height:1.25;
    white-space:normal;
  }
}
@media (max-width:900px){
  .reports-tabs .reports-side__btn{ padding:13px 12px 14px; font-size:14.5px; }
  /* mobile : onglets programmes d'abord, puis types, puis la grille */
  .reports-layout > *{ min-width:0; }
  .reports-main{ display:contents; }
  .reports-tabs{ order:-1; margin-bottom:0; }
  .reports-side{ order:0; }
  .reports-layout > .reports-grid,
  .reports-layout > .reports-empty,
  .reports-layout > .category__loadmore{ order:1; }
}

