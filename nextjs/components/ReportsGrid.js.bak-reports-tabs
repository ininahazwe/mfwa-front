"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import FadeImg from "./FadeImg";

// Sidebar-filtered reports grid (2026-09-27, at Yv's call) — mirrors the
// live site's Publications archive layout (e.g.
// https://mfwa.org/publications/foedr-reports/): a left-hand list of
// report-type filters next to a grid of cards. Every report is fetched
// up front by getReportsPage() and filtering happens entirely
// client-side here — same pattern as the homepage's "topics" filter in
// Latest.js — so clicking a filter is instant, no API round trip.
// `filters` only lists types that actually have at least one matching
// report right now (computed in getReportsPage() from the fetched data,
// not a hardcoded list): a type with zero reports simply never renders a
// button, and reappears on its own once a report using it is published.
// See the note above getWpReports()/mapReport() in lib/wp.js for what
// "filterTerms" actually are and what's still unconfirmed about them.
//
// Found and fixed (2026-09-28) — the actual "grid stays empty" bug: this
// used to wrap the grid in <Reveal stagger>, the same scroll-reveal
// fade-in every other grid on the site uses (CategoryGrid.js). Reveal
// only adds its "is-visible" class (the one thing that takes opacity
// from 0 to 1) once an IntersectionObserver reports the element at
// least 15% inside the viewport. That works for CategoryGrid because it
// paginates ("load more"), so its grid stays short. Reports deliberately
// loads its WHOLE corpus at once for instant client-side filtering (Yv's
// original ask) — with 45+ cards that makes the grid several times
// taller than the screen, so even a full viewport's worth of it in view
// is well under 15% of its TOTAL height, and the 15% threshold is never
// crossed: the grid sat at opacity:0 forever, invisible but fully
// present in the DOM (which is why `.reports-grid .story` always
// counted correctly in tests, and why disabling the filters or fixing
// the data fetch — see lib/wp.js's retry/522 and 2MB-cache fixes —
// never helped: neither one touched this). Fix: this grid no longer
// uses Reveal at all — it renders as a plain div, visible immediately,
// which also suits a fully-loaded, instantly-filterable list better
// than a scroll-in animation anyway.
// Same initial page size CategoryGrid.js uses for its own "load more"
// grids, so Reports doesn't stand out from the rest of the site.
const PAGE_SIZE = 12;

export default function ReportsGrid({ articles, filters, categories = [], initialCategory }) {
  const [activeFilter, setActiveFilter] = useState(null);
  // Programme tabs (retours équipe com #11, 2026-10-16): the live site's 3
  // higher-level report groupings. `initialCategory` comes from
  // /reports?category=<slug> (the "Browse the reports" button on each
  // programme page); an unknown slug just means "All".
  const [activeCategory, setActiveCategory] = useState(
    categories.some((c) => c.slug === initialCategory) ? initialCategory : null
  );
  // "hasMore" pagination (2026-09-28, at Yv's call), on top of the fix
  // above: everything is still fetched and filtered up front (no extra
  // API round trip — the whole point of this page), but only
  // `displayCount` of the current, already-filtered list is actually
  // rendered at a time, with a "Load more" button underneath — same
  // pattern as CategoryGrid.js's own hasMore/"load more", just driven
  // from the in-memory list instead of another page fetch. This also
  // keeps the DOM (and the page's real height) from ballooning to
  // hundreds of cards at once on an archive that keeps growing.
  const [displayCount, setDisplayCount] = useState(PAGE_SIZE);

  const filtered = useMemo(() => {
    return articles.filter(
      (story) =>
        (!activeFilter || story.filterTerms.some((f) => f.slug === activeFilter)) &&
        (!activeCategory || (story.categoryTerms ?? []).some((c) => c.slug === activeCategory))
    );
  }, [activeFilter, activeCategory, articles]);

  // Switching filters always starts back at the first page — otherwise
  // "Annual Reports" could open already expanded to however many cards
  // "All" happened to be showing, which reads as broken rather than
  // filtered.
  function selectFilter(slug) {
    setActiveFilter(slug);
    setDisplayCount(PAGE_SIZE);
  }
  function selectCategory(slug) {
    setActiveCategory(slug);
    setDisplayCount(PAGE_SIZE);
  }

  const visible = filtered.slice(0, displayCount);
  const hasMore = displayCount < filtered.length;

  const grid = (
    <>
      <div className="reports-grid">
        {visible.map((story, i) => (
          <ReportCard story={story} key={`${story.link}-${i}`} />
        ))}
      </div>
      {filtered.length === 0 && <p className="reports-empty">No reports in this category yet.</p>}
      {hasMore && (
        <div className="category__loadmore">
          <button type="button" className="btn btn--loadmore" onClick={() => setDisplayCount((c) => c + PAGE_SIZE)}>
            Load more
          </button>
        </div>
      )}
    </>
  );

  // Sidebar redesign (2026-10-18, at Yv's call — inspired by a classic app
  // side-nav: a heading block with a muted sub-line, a hairline, then
  // roomy icon + label rows, the active row marked only by a vertical
  // accent bar on the left edge; no pills, no filled backgrounds). Both
  // groups — programme tabs (.reports-tabs) and report-type filters
  // (.reports-filters) — now live together in that left column. Same
  // state, same filtering as before; only the markup/CSS changed.
  // Revert: ReportsGrid.js.bak-reports-nav + globals.css.bak-reports-nav.
  const byCategory = activeCategory
    ? articles.filter((story) => (story.categoryTerms ?? []).some((c) => c.slug === activeCategory))
    : articles;
  const typeCounts = {};
  for (const story of byCategory) {
    for (const f of story.filterTerms ?? []) typeCounts[f.slug] = (typeCounts[f.slug] ?? 0) + 1;
  }

  const tabs =
    categories.length > 0 ? (
      <div className="reports-group">
        <div className="reports-group__head">
          <p className="reports-group__title">Programmes</p>
          <p className="reports-group__sub">{articles.length} reports in total</p>
        </div>
        <nav className="reports-tabs" aria-label="Browse reports by programme">
          <SideButton
            className="reports-tabs__btn"
            active={!activeCategory}
            icon="all"
            label="All reports"
            count={articles.length}
            onClick={() => selectCategory(null)}
          />
          {categories.map((c) => (
            <SideButton
              key={c.slug}
              className="reports-tabs__btn"
              active={activeCategory === c.slug}
              icon={categoryIcon(c.slug)}
              label={c.slug === "annual-reports" ? c.name : c.name.replace(/ Reports$/, "")}
              count={c.count}
              onClick={() => selectCategory(c.slug)}
            />
          ))}
        </nav>
      </div>
    ) : null;

  const types =
    filters.length > 0 ? (
      <div className="reports-group">
        <div className="reports-group__head">
          <p className="reports-group__title">Report type</p>
          <p className="reports-group__sub">
            {filters.length} {filters.length > 1 ? "types" : "type"}
          </p>
        </div>
        <nav className="reports-filters" aria-label="Filter reports by type">
          <SideButton
            className="reports-filters__btn"
            active={!activeFilter}
            icon="layers"
            label="All"
            count={byCategory.length}
            onClick={() => selectFilter(null)}
          />
          {filters.map((f) => (
            <SideButton
              key={f.slug}
              className="reports-filters__btn"
              active={activeFilter === f.slug}
              icon={typeIcon(f)}
              label={f.name}
              count={typeCounts[f.slug] ?? 0}
              dim={!typeCounts[f.slug] && activeFilter !== f.slug}
              onClick={() => selectFilter(f.slug)}
            />
          ))}
        </nav>
      </div>
    ) : null;

  // Mobile: the two groups become horizontally scrolling rows — keep the
  // active row in view (e.g. /reports?category=mdgg-reports preselects the
  // last tab, which would otherwise start off-screen). Desktop: no-op.
  const sideRef = useRef(null);
  useEffect(() => {
    sideRef.current?.querySelectorAll(".reports-tabs, .reports-filters").forEach((row) => {
      const btn = row.querySelector(".is-active");
      if (btn && row.scrollWidth > row.clientWidth) row.scrollLeft = Math.max(0, btn.offsetLeft - row.offsetLeft - 16);
    });
  }, [activeCategory, activeFilter]);

  if (!tabs && !types) return grid;

  return (
    <div className="reports-layout">
      <aside className="reports-side" ref={sideRef}>
        {tabs}
        {types}
      </aside>
      <div className="reports-main">{grid}</div>
    </div>
  );
}

/* ---------- side-nav rows ---------- */

function SideButton({ className, active, icon, label, count, dim, onClick }) {
  return (
    <button
      type="button"
      className={`reports-side__btn ${className}${active ? " is-active" : ""}${dim ? " is-dim" : ""}`}
      aria-pressed={active}
      onClick={onClick}
    >
      <span className="reports-side__icon" aria-hidden="true">
        {SIDE_ICONS[icon] ?? SIDE_ICONS.doc}
      </span>
      <span className="reports-side__label">{label}</span>
      <span className="reports-side__count">{count}</span>
    </button>
  );
}

function categoryIcon(slug) {
  if (/annual/.test(slug)) return "calendar";
  if (/foe|expression|digital/.test(slug)) return "mic";
  if (/mdgg|democracy|governance/.test(slug)) return "newspaper";
  return "folder";
}

function typeIcon(f) {
  const key = `${f.slug} ${f.name}`.toLowerCase();
  if (/annual/.test(key)) return "calendar";
  if (/monitor/.test(key)) return "eye";
  if (/month|quarter/.test(key)) return "clock";
  if (/polic|brief|paper/.test(key)) return "doc";
  if (/research/.test(key)) return "search";
  if (/analy/.test(key)) return "bars";
  if (/strateg|framework/.test(key)) return "compass";
  return "doc";
}

